      "timeout_seconds": 1800,
      "parameter_schema": {"type": "object", "properties": {"prompt": {"type": "string", "minLength": 1, "maxLength": 500}, "box": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false}, "points": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}}, "confidence": {"type": "number", "minimum": 0.05, "maximum": 1}, "refine": {"type": "boolean"}}, "anyOf": [{"required": ["prompt"]}, {"required": ["box"]}, {"required": ["points"]}], "additionalProperties": false},
