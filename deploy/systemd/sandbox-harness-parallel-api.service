[Unit]
Description=Sandbox Harness web and session API
After=network-online.target sandbox-harness-parallel-postgresql.service redis-server.service sandbox-agent-opensandbox.service
Requires=sandbox-harness-parallel-postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sandbox-harness
Group=sandbox-harness
WorkingDirectory=/data2/wujing03/sandbox-harness-platform-parallel
EnvironmentFile=/data2/wujing03/sandbox-harness-platform-parallel/.data/config/platform.env
Environment=TMPDIR=/data2/wujing03/sandbox-harness-platform-parallel/.data/tmp
Environment=XDG_CACHE_HOME=/data2/wujing03/sandbox-harness-platform-parallel/.data/cache
Environment=PIP_CACHE_DIR=/data2/wujing03/sandbox-harness-platform-parallel/.data/pip-cache
Environment=UV_CACHE_DIR=/data2/wujing03/sandbox-harness-platform-parallel/.data/uv-cache
Environment=npm_config_cache=/data2/wujing03/sandbox-harness-platform-parallel/.data/npm-cache
Environment=PLAYWRIGHT_BROWSERS_PATH=/data2/wujing03/sandbox-harness-platform-parallel/.data/playwright-browsers
ExecStartPre=+/usr/bin/install -d -o sandbox-harness -g sandbox-harness -m 0750 /data2/wujing03/sandbox-harness-platform-parallel/.data/tmp/runtime-downloads
ExecStart=/data2/wujing03/sandbox-harness-platform-parallel/.venv/bin/sandbox-harness-parallel-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,mode=1777
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data2/wujing03/sandbox-harness-platform-parallel/.data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
TasksMax=256
LimitNOFILE=8192
StandardOutput=append:/data2/wujing03/sandbox-harness-platform-parallel/.data/service-logs/api.log
StandardError=append:/data2/wujing03/sandbox-harness-platform-parallel/.data/service-logs/api.log

[Install]
WantedBy=multi-user.target
