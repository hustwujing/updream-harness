[Unit]
Description=Sandbox Harness media generation worker
After=network-online.target sandbox-harness-parallel-postgresql.service
Requires=sandbox-harness-parallel-postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sandbox-harness
Group=sandbox-harness
WorkingDirectory=/data2/wujing03/sandbox-harness-platform-parallel
EnvironmentFile=/data2/wujing03/sandbox-harness-platform-parallel/.data/config/platform.env
Environment=TMPDIR=/data2/wujing03/sandbox-harness-platform-parallel/.data/tmp
Environment=XDG_CACHE_HOME=/data2/wujing03/sandbox-harness-platform-parallel/.data/cache
ExecStart=/data2/wujing03/sandbox-harness-platform-parallel/.venv/bin/sandbox-harness-parallel-media-worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data2/wujing03/sandbox-harness-platform-parallel/.data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
TasksMax=128
LimitNOFILE=4096
StandardOutput=append:/data2/wujing03/sandbox-harness-platform-parallel/.data/service-logs/media-worker.log
StandardError=append:/data2/wujing03/sandbox-harness-platform-parallel/.data/service-logs/media-worker.log

[Install]
WantedBy=multi-user.target
