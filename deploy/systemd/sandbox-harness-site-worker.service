[Unit]
Description=Sandbox Harness static site deployment worker
After=network-online.target sandbox-harness-postgresql.service
Requires=sandbox-harness-postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sandbox-harness
Group=sandbox-harness
WorkingDirectory=/data2/wujing03/sandbox-harness-platform
EnvironmentFile=/data2/wujing03/sandbox-harness-platform/.data/config/platform.env
Environment=TMPDIR=/data2/wujing03/sandbox-harness-platform/.data/tmp
Environment=XDG_CACHE_HOME=/data2/wujing03/sandbox-harness-platform/.data/cache
ExecStart=/data2/wujing03/sandbox-harness-platform/.venv/bin/sandbox-harness-site-worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data2/wujing03/sandbox-harness-platform/.data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
TasksMax=96
LimitNOFILE=4096
StandardOutput=append:/data2/wujing03/sandbox-harness-platform/.data/service-logs/site-worker.log
StandardError=append:/data2/wujing03/sandbox-harness-platform/.data/service-logs/site-worker.log

[Install]
WantedBy=multi-user.target
